# Zkopíruj tento soubor jako .env.local a doplň skutečné hodnoty.
# V produkci se stejné proměnné nastavují ve Vercelu:
# Project → Settings → Environment Variables

# Umami Analytics — Website ID z cloud.umami.is (Settings → Websites → Edit)
# Když je prázdné, tracker se vůbec nenačte (proto lokální vývoj statistiky nezkresluje).
VITE_UMAMI_WEBSITE_ID=

# Resend — odesílání notifikací o nových zájemcích z waitlistu
VITE_RESEND_API_KEY=
